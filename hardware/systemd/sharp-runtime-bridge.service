[Unit]
Description=SHARP runtime bridge (what the dashboard displays)
# Start once Wi-Fi is up; the script itself also retries until the broker
# answers, so a slow network at boot is fine.
Wants=network-online.target
After=network-online.target
# Never stop retrying.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python -u hardware/runtime_bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
